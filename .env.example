# ---------- Retell ----------
# Dashboard → Settings → API Keys.
#
# IMPORTANT: Retell issues more than one key and only ONE of them signs
# webhooks — it has a webhook badge beside it in the dashboard. Use that one.
# With any other key the agent still answers and talks normally, but every
# tool call and webhook returns 401, so nothing is ever booked, recorded or
# emailed. It is the single most confusing failure mode in this app.
RETELL_API_KEY=key_xxxxxxxxxxxxxxxxxxxxxxxx

# Set to false ONLY while testing endpoints with curl. Never in production.
# RETELL_VERIFY_SIGNATURE=false

# ---------- This deployment ----------
# Public https URL. Retell calls these endpoints from its own servers, so
# localhost and private IPs are rejected.
#
# After changing this: redeploy, THEN press Save on every agent. The tool and
# webhook URLs are baked in when an agent is saved, so an agent saved against
# the old URL keeps calling the old host.
APP_BASE_URL=https://your-project.vercel.app

# Shown in the sidebar, on the login page, in the browser tab and at the
# bottom of every summary email.
BRAND_NAME=Hawkings Law

# Used on appointment records and available to agent prompts.
BUSINESS_NAME=Hawkings Law

# ---------- Database ----------
# Everything lives here: appointments, enquiries, custom logs, contacts,
# campaigns. There is no spreadsheet and no external calendar.
#
# Supabase → Project Settings → Data API for the URL, and API Keys for the
# key. Use the SERVICE ROLE key, not the anon key — it bypasses row level
# security, which is why it must never reach the browser.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ---------- Call summary emails ----------
# Sent after each call: summary, outcome, duration, recording link, transcript.
#
# For Gmail this must be an App Password, NOT the account password:
#   1. myaccount.google.com → Security → turn on 2-Step Verification
#   2. Security → App passwords → create one, name it anything
#   3. Google shows 16 characters like "abcd efgh ijkl mnop"
#   4. Paste them here. Spaces are stripped automatically.
SMTP_USER=reception@hawkingslaw.com
SMTP_PASSWORD=abcdefghijklmnop

# Only change these for a non-Gmail provider.
# 465 = implicit TLS (the default), 587 = STARTTLS.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# Fallback recipient for agents that don't set their own on /agents.
# Comma-separate for several people.
# SUMMARY_EMAIL=partner@hawkingslaw.com

# ---------- Access ----------
# Guards the console and its API.
ADMIN_TOKEN=pick-a-long-random-string

# Guards /api/cron/campaign-tick. Give this to cron-job.org.
CRON_SECRET=another-long-random-string

# Enables /setup and its checks. REMOVE THIS once the firm is live — while it
# is set, anyone with the token can reach the diagnostics.
SETUP_TOKEN=a-third-long-random-string

# ---------- Appointment rules ----------
BUSINESS_TIMEZONE=Europe/London
BUSINESS_START_HOUR=9
BUSINESS_END_HOUR=17
# 1=Mon ... 7=Sun
WORKING_DAYS=1,2,3,4,5
APPOINTMENT_MINUTES=30
SLOT_STEP_MINUTES=30
# Stops "book me in two minutes".
MIN_LEAD_MINUTES=60
MAX_DAYS_AHEAD=60
# Three is the sweet spot to read back on a phone call.
MAX_SLOTS_RETURNED=3

# ---------- Optional: text alerts ----------
# A text the moment the agent books someone or finds an interested caller.
# The sending number must be SMS-capable — most UK landline numbers are not.
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your-twilio-auth-token
# TWILIO_SMS_FROM=+441234567890
# Fallback recipient when an agent has no alert number of its own.
# ALERT_NUMBER=+447400123456

# ---------- Optional: transfer fallback ----------
# Fallback number for agents with no transfer number of their own. E.164 only.
# TRANSFER_NUMBER=+441234567890
